{
  "name": "@game-harness/core",
  "version": "0.1.0",
  "description": "Minimal self-evolving harness core for game development projects.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./profiles/balance-island": {
      "types": "./dist/profiles/balance-island/index.d.ts",
      "import": "./dist/profiles/balance-island/index.js"
    }
  },
  "bin": {
    "game-harness": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "game-development",
    "harness",
    "ai-agent",
    "evidence"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
