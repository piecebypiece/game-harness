{
  "name": "@game-harness/core",
  "version": "0.2.0",
  "description": "Protocol-first evidence and decision sidecar for AI-assisted game development.",
  "type": "module",
  "workspaces": [
    "packages/protocol"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./profiles/balance-island": {
      "types": "./dist/profiles/balance-island/index.d.ts",
      "import": "./dist/profiles/balance-island/index.js"
    },
    "./protocol": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "bin": {
    "game-harness": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "packages/protocol/dist",
    "packages/protocol/schemas",
    "packages/protocol/package.json",
    "packages/protocol/README.md",
    "packages/protocol/LICENSE",
    "docs",
    "fixtures",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build:protocol": "npm run build --workspace @game-harness/protocol",
    "build": "npm run build:protocol && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "test": "npm run build && node --test packages/protocol/tests/*.test.mjs tests/*.test.mjs",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "test:protocol": "npm test --workspace @game-harness/protocol",
    "typecheck": "npm run build:protocol && tsc -p tsconfig.json --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run verify:package"
  },
  "keywords": [
    "game-development",
    "harness",
    "ai-agent",
    "evidence"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piecebypiece/game-harness.git"
  },
  "homepage": "https://github.com/piecebypiece/game-harness#readme",
  "bugs": {
    "url": "https://github.com/piecebypiece/game-harness/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@game-harness/protocol": "file:packages/protocol"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
