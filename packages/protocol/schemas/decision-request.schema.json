{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-harness.decision-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at", "request_id", "question", "options", "recommendation", "blocking", "intent_hash", "expires_at"],
  "properties": {
    "schema": { "const": "game-harness.decision-request.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "request_id": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "options": { "type": "array", "items": { "type": "object" }, "minItems": 2 },
    "recommendation": { "type": "string", "minLength": 1 },
    "blocking": { "type": "boolean" },
    "intent_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
