{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-harness.agent-model.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at", "agent_surface", "model_family", "context_budget", "tools", "write_permission", "risk_notes"],
  "properties": {
    "schema": { "const": "game-harness.agent-model.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "agent_surface": { "type": "string", "minLength": 1 },
    "model_family": { "type": "string", "minLength": 1 },
    "context_budget": { "type": "string", "minLength": 1 },
    "tools": { "type": "array", "items": { "type": "string" } },
    "write_permission": { "enum": ["read-only", "proposal-only", "workspace-write", "full"] },
    "risk_notes": { "type": "array", "items": { "type": "string" } }
  }
}
