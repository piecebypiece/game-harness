{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-harness.run-attempt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at", "run_id", "intent_hash", "attempt", "state", "idempotency_key", "fencing_token", "remote_receipt", "recovery_action"],
  "properties": {
    "schema": { "const": "game-harness.run-attempt.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "minLength": 1 },
    "intent_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["PREPARED", "COMMITTED", "ROLLED_BACK", "UNKNOWN"] },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "fencing_token": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
    "remote_receipt": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "recovery_action": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
  }
}
