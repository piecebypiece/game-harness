{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-harness.run-envelope.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at", "run_id", "capability", "module_id", "permissions", "input_hashes", "output_refs", "status", "limitations"],
  "properties": {
    "schema": { "const": "game-harness.run-envelope.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "module_id": { "type": "string", "minLength": 1 },
    "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "input_hashes": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "output_refs": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["PLANNED", "RUNNING", "WAITING_DECISION", "COMPLETED", "FAILED", "CANCELLED"] },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
