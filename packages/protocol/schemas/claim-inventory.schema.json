{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-harness.claim-inventory.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at", "requirement_set_id", "requirement_set_version", "denominator_hash", "claims", "limitations"],
  "properties": {
    "schema": { "const": "game-harness.claim-inventory.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "requirement_set_id": { "type": "string", "minLength": 1 },
    "requirement_set_version": { "type": "integer", "minimum": 1 },
    "denominator_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement_ids", "statement", "required_evidence_axes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "requirement_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "statement": { "type": "string", "minLength": 1 },
          "required_evidence_axes": { "type": "array", "items": { "enum": ["source", "build", "focused-test", "editor", "runtime", "human"] }, "minItems": 1, "uniqueItems": true }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
