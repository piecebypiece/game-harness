{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-harness.evaluation-assignment.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at", "assignment_id", "evaluator", "independence", "relationship", "packet_hash", "claim_inventory_hash", "read_only", "allowed_tools"],
  "properties": {
    "schema": { "const": "game-harness.evaluation-assignment.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "assignment_id": { "type": "string", "minLength": 1 },
    "evaluator": { "type": "string", "minLength": 1 },
    "independence": { "enum": ["E0", "E1", "E2"] },
    "relationship": { "type": "string", "minLength": 1 },
    "packet_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "claim_inventory_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "read_only": { "const": true },
    "allowed_tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
