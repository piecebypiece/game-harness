{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-harness.execution-intent.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at", "intent_id", "operation", "target", "payload_digest", "write_set_digest", "state_hash", "plan_hash", "idempotency_key", "permissions", "cost_ceiling", "expires_at"],
  "properties": {
    "schema": { "const": "game-harness.execution-intent.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "intent_id": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "payload_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "write_set_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "state_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "cost_ceiling": { "type": "number", "minimum": 0 },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
