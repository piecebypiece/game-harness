{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-harness.work-item-projection.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at", "work_item_id", "source", "source_hash", "goal", "scope", "status", "acceptance_source"],
  "properties": {
    "schema": { "const": "game-harness.work-item-projection.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "work_item_id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "goal": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "minLength": 1 },
    "acceptance_source": { "type": "string", "minLength": 1 }
  }
}
