{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-harness.module-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "api_version", "id", "version", "kind", "source", "integrity", "trust", "capabilities", "inputs", "outputs", "semantic_contract", "dependencies", "conflicts", "permissions", "write_surface", "rollback", "uninstall"],
  "properties": {
    "schema": { "const": "game-harness.module-manifest.v1" },
    "api_version": { "const": "game-harness.dev/v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "trust": { "enum": ["builtin", "signed", "unsigned", "local-dev"] },
    "capabilities": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "semantic_contract": { "type": "string", "minLength": 1 },
    "config_schema": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "conflicts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "permissions": { "type": "object" },
    "write_surface": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "rollback": { "enum": ["supported", "unsupported"] },
    "uninstall": { "enum": ["owned-files-only", "manual"] }
  }
}
