{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-harness.evaluation-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at", "assignment_id", "evaluator", "independence", "packet_hash", "claim_inventory_hash", "status", "findings", "evidence_refs", "limitations"],
  "properties": {
    "schema": { "const": "game-harness.evaluation-result.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "assignment_id": { "type": "string", "minLength": 1 },
    "evaluator": { "type": "string", "minLength": 1 },
    "independence": { "enum": ["E0", "E1", "E2"] },
    "packet_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "claim_inventory_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["PASS", "FAIL", "PARTIAL", "BLOCKED", "NOT_RUN"] },
    "findings": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
