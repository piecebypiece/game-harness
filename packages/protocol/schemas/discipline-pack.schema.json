{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-harness.discipline-pack.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "api_version", "id", "version", "requires", "optional", "track_policy", "required_claim_kinds", "required_evidence_axes", "decision_gates", "resolver_policy"],
  "properties": {
    "schema": { "const": "game-harness.discipline-pack.v1" },
    "api_version": { "const": "game-harness.dev/v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "requires": { "type": "array", "items": { "type": "object" }, "minItems": 1 },
    "optional": { "type": "array", "items": { "type": "object" } },
    "track_policy": { "type": "string", "minLength": 1 },
    "required_claim_kinds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "required_evidence_axes": { "type": "array", "items": { "enum": ["source", "build", "focused-test", "editor", "runtime", "human"] }, "minItems": 1, "uniqueItems": true },
    "decision_gates": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "resolver_policy": { "type": "string", "minLength": 1 }
  }
}
