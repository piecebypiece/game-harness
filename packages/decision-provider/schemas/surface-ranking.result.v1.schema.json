{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-harness.surface-ranking.result/1",
  "$comment": "ID 전체 일대일 대응, 토큰 합계, minConfidence는 runtime의 의미 검증을 따른다.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "provider", "model", "status", "reason", "rankings", "usage", "elapsedMs"],
  "properties": {
    "schema": { "const": "game-harness.surface-ranking.result/1" },
    "provider": { "const": "openai-decisions" }, "model": { "const": "gpt-6-luna" },
    "status": { "enum": ["ok", "unavailable", "error"] }, "reason": { "type": ["string", "null"] },
    "elapsedMs": { "type": "number", "minimum": 0 },
    "rankings": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "label", "confidence"],
        "properties": {
          "id": { "type": "string" }, "label": { "enum": ["high", "medium", "low", "unknown"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "usage": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["inputTokens", "outputTokens", "totalTokens"],
          "properties": {
            "inputTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "outputTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "totalTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ok" } } },
      "then": {
        "properties": {
          "reason": { "type": "null" }, "usage": { "type": "object" },
          "rankings": { "items": { "properties": { "label": { "enum": ["high", "medium", "low"] } } } }
        }
      },
      "else": {
        "properties": { "reason": { "type": "string", "minLength": 1 }, "rankings": { "maxItems": 0 }, "usage": { "type": "null" } }
      }
    }
  ]
}
