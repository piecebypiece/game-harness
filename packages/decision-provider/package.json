{
  "name": "@game-harness/decision-provider",
  "version": "0.1.1-jev.0",
  "description": "선택적으로 사용하는 Decisions·Jev API 표면 후보 평가 공급자",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "import": "./src/index.js" },
    "./schemas/*": "./schemas/*"
  },
  "files": ["src", "schemas", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "test": "node --test tests/provider.test.mjs tests/jev.test.mjs tests/schemas.test.mjs tests/windows-key.test.mjs",
    "typecheck": "tsc -p tsconfig.consumer.json --noEmit"
  },
  "engines": { "node": ">=20" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piecebypiece/game-harness.git",
    "directory": "packages/decision-provider"
  },
  "license": "MIT",
  "devDependencies": { "ajv": "8.17.1", "typescript": "5.7.3" }
}
